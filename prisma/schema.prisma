// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Event {
  id                   String   @id @default(cuid())
  title                String
  description          String?  @db.Text
  type                 String   @default("DATE_POLL") // "DATE_POLL" | "SIMPLE_POLL"
  pollOptions          String?  @db.Text               // JSON array of strings
  allowMultipleChoices Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tokens    Token[]
  responses Response[]
}

model Token {
  id        String   @id @default(cuid())
  eventId   String

  // LOGIQUE HYBRIDE : Type de lien
  type      String   @default("PRIVATE") // "PRIVATE" ou "PUBLIC"

  isUsed    Boolean  @default(false)
  usedBy    String?
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Changement ici : Un token Public peut avoir PLUSIEURS réponses
  responses Response[]

  @@index([eventId])
}

model Response {
  id        String   @id @default(cuid())
  eventId   String
  tokenId   String   // Suppression de @unique ici pour permettre plusieurs réponses sur un même token public

  guestName String
  dates     String?  @db.Text // JSON stringifié — pour DATE_POLL
  choices   String?  @db.Text // JSON stringifié — pour SIMPLE_POLL
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token     Token    @relation(fields: [tokenId], references: [id])

  @@index([eventId])
  @@index([tokenId]) // Ajout d'un index pour la performance
}